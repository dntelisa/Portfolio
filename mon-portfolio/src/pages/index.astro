---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.vue'
import About from '../layouts/About.astro'
import Experience from '../components/Experiences.vue'
import Projects from '../components/Projects.vue'
import TechStack from '../components/TechStack.vue'
import Offline from '../layouts/Offline.astro'
---

<Layout title="Elisa Donet | Développeuse Frontend">
  <!-- Ton menu de navigation -->
  <Header client:load lang="en" />

  <!-- Le contenu de la page d'accueil -->
  <main>
    <About lang="en" />
    <Experience client:visible lang="en" />
    <Projects client:visible lang="en" />
    <TechStack client:visible lang="en" />
    <Offline lang="en" />
  </main>
</Layout>
