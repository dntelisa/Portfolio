    <h1 class="text-5xl font-extrabold tracking-tight text-white sm:text-6xl">
      Salut ! Je m'appelle <span class="text-emerald-400">Elisa</span>.
    </h1>

    <!-- Le corps du texte aéré avec une belle hauteur de ligne (leading-relaxed) -->
